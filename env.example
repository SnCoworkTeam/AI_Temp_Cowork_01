# 项目环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# Python版本
PYTHON_VERSION=3.11

# Node版本
NODE_VERSION=20

# 调试模式
DEBUG=true

# 日志级别 (critical, error, warning, info, debug, trace)
# 注意：uvicorn 需要小写
LOG_LEVEL=info

# PostgreSQL数据库配置
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=enterprise_ai_platform

# Redis配置
REDIS_HOST=redis
REDIS_PORT=6379

# MCP Gateway配置
MCP_GATEWAY_PORT=8001

# Workflow Engine配置
WORKFLOW_ENGINE_PORT=8002

# Web UI配置
WEB_UI_PORT=3000

# Auth Service配置
AUTH_SERVICE_PORT=8003

# Knowledge Base配置
KNOWLEDGE_BASE_PORT=8004
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
DOCUMENT_STORAGE_DIR=./documents
MAX_FILE_SIZE=104857600
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# SMTP邮件配置（用于send_email工具）
SMTP_SERVER=smtp.163.com
SMTP_PORT=465
SMTP_USERNAME=lyb-005@163.com
SMTP_PASSWORD=Liu@bner1983
SMTP_FROM_EMAIL=lyb-005@163.com
SMTP_USE_TLS=false
SMTP_USE_SSL=true

# Metadata Service配置
METADATA_SERVICE_PORT=8005

# AI服务配置
# 支持 OpenAI 或 DeepSeek API（DeepSeek 完全兼容 OpenAI API 格式）
# 使用 OpenAI: 设置 OPENAI_API_KEY，使用默认 base_url
# 使用 DeepSeek: 设置 OPENAI_API_KEY 为 DeepSeek 的 API Key，设置 LLM_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=your-api-key-here
# LLM服务基础URL（可选，默认使用OpenAI官方API）
# 使用DeepSeek时设置为: https://api.deepseek.com
LLM_BASE_URL=https://api.deepseek.com
# LLM模型名称（默认: gpt-4，使用DeepSeek时建议: deepseek-chat）
LLM_MODEL=deepseek-chat
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_TRACING_V2=false

# MCP Gateway配置
MCP_GATEWAY_PORT=8001

# MCP服务器配置（JSON格式）
# 示例: [{"name": "weather_mcp", "url": "ws://localhost:8080/mcp", "timeout": 30, "auto_connect": true}]
MCP_SERVERS=[]

# 工具自动刷新配置
AUTO_REFRESH_TOOLS=true
TOOL_REFRESH_INTERVAL=300

# MCP连接池配置
MCP_CONNECTION_POOL_SIZE=5
MCP_MAX_RETRIES=3

# 前端API地址（浏览器访问）
NEXT_PUBLIC_MCP_GATEWAY_URL=http://localhost:8001
NEXT_PUBLIC_WORKFLOW_ENGINE_URL=http://localhost:8002
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8003
NEXT_PUBLIC_KNOWLEDGE_BASE_URL=http://localhost:8004
NEXT_PUBLIC_METADATA_SERVICE_URL=http://localhost:8005
# 前端LLM模型配置（用于工作流设计器的默认模型）
NEXT_PUBLIC_LLM_MODEL=deepseek-chat

# 服务间通信地址（容器内部）
WORKFLOW_ENGINE_URL=http://workflow-engine:8002
MCP_GATEWAY_URL=http://mcp-gateway:8001
AUTH_SERVICE_URL=http://auth-service:8003
KNOWLEDGE_BASE_URL=http://knowledge-base:8004
METADATA_SERVICE_URL=http://metadata-service:8005


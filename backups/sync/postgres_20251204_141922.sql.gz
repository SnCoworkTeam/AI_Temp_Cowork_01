ccc53e3f-bfea-4633-a2d6-84a288bb2f41	knowledge_search	从企业知识库中搜索相关信息，用于回答问题和支持决策。支持语义搜索和关键词搜索两种模式。	\N	CUSTOM	{"type": "object", "required": ["query"], "properties": {"limit": {"type": "integer", "default": 5, "maximum": 20, "minimum": 1, "description": "返回结果数量限制"}, "query": {"type": "string", "required": true, "description": "搜索查询文本"}, "filters": {"type": "object", "required": false, "description": "过滤条件（如文档ID、标签等）"}, "match_all": {"type": "boolean", "default": false, "description": "关键词搜索时是否匹配所有关键词（仅对keyword类型有效）"}, "search_type": {"enum": ["semantic", "keyword"], "type": "string", "default": "semantic", "description": "搜索类型：semantic（语义搜索）或keyword（关键词搜索）"}}}	\N	t	\N	2025-11-25 07:30:03.640227	2025-11-25 07:30:03.640227	1.0.0	["query"]	object	{}	{}	0	0	0	\N	ACTIVE

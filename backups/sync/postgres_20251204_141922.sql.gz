    key character varying(200) NOT NULL,
    value text,
    value_type character varying(50) DEFAULT 'string'::character varying NOT NULL,
    category public.configcategory DEFAULT 'system'::public.configcategory NOT NULL,
    description text,
    is_encrypted boolean DEFAULT false NOT NULL,
    is_public boolean DEFAULT false NOT NULL,
    created_at timestamp without time zone DEFAULT now() NOT NULL,
    updated_at timestamp without time zone DEFAULT now() NOT NULL
);


ALTER TABLE public.system_configs OWNER TO ai_user;

--
-- Name: user_feedback; Type: TABLE; Schema: public; Owner: ai_user
--

CREATE TABLE public.user_feedback (
    id integer NOT NULL,
    query_id character varying(255) NOT NULL,
    query text NOT NULL,
    feedback_type character varying(20) NOT NULL,
    result_id character varying(255),
    comment text,
    user_id character varying(255),
    extra_metadata jsonb,
    created_at timestamp without time zone DEFAULT CURRENT_TIMESTAMP
);


ALTER TABLE public.user_feedback OWNER TO ai_user;

--
-- Name: user_feedback_id_seq; Type: SEQUENCE; Schema: public; Owner: ai_user
--

CREATE SEQUENCE public.user_feedback_id_seq
    AS integer
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1;


ALTER TABLE public.user_feedback_id_seq OWNER TO ai_user;

--
-- Name: user_feedback_id_seq; Type: SEQUENCE OWNED BY; Schema: public; Owner: ai_user
--

ALTER SEQUENCE public.user_feedback_id_seq OWNED BY public.user_feedback.id;


--
-- Name: user_roles; Type: TABLE; Schema: public; Owner: ai_user
--

CREATE TABLE public.user_roles (
    user_id uuid NOT NULL,
    role_id uuid NOT NULL,
    created_at timestamp without time zone DEFAULT now() NOT NULL
);


ALTER TABLE public.user_roles OWNER TO ai_user;

--
-- Name: user_sessions; Type: TABLE; Schema: public; Owner: ai_user
--

CREATE TABLE public.user_sessions (
    id uuid NOT NULL,
    user_id uuid NOT NULL,
    access_token character varying(500),
    refresh_token character varying(500),
    ip_address character varying(50),
    user_agent character varying(500),
    expires_at timestamp without time zone NOT NULL,
    is_active boolean DEFAULT true NOT NULL,
    created_at timestamp without time zone DEFAULT now() NOT NULL,
    updated_at timestamp without time zone DEFAULT now() NOT NULL
);


ALTER TABLE public.user_sessions OWNER TO ai_user;

--
-- Name: users; Type: TABLE; Schema: public; Owner: ai_user
--

CREATE TABLE public.users (
    id uuid NOT NULL,
    username character varying(100) NOT NULL,
    email character varying(255) NOT NULL,
    password_hash character varying(255) NOT NULL,
    full_name character varying(200),
    avatar_url character varying(500),
    status public.userstatus DEFAULT 'active'::public.userstatus NOT NULL,
    last_login_at timestamp without time zone,
    last_login_ip character varying(50),
    user_metadata jsonb,
    created_at timestamp without time zone DEFAULT now() NOT NULL,
    updated_at timestamp without time zone DEFAULT now() NOT NULL
);


ALTER TABLE public.users OWNER TO ai_user;

--
-- Name: value_metrics; Type: TABLE; Schema: public; Owner: ai_user
--

CREATE TABLE public.value_metrics (
    id integer NOT NULL,
    operation character varying(100) NOT NULL,
    time_saved_seconds double precision,
    error_reduced integer,
    efficiency_improvement double precision,
    user_id character varying(255),
    extra_metadata jsonb,
    created_at timestamp without time zone DEFAULT CURRENT_TIMESTAMP
);


ALTER TABLE public.value_metrics OWNER TO ai_user;

--
-- Name: value_metrics_id_seq; Type: SEQUENCE; Schema: public; Owner: ai_user
--

CREATE SEQUENCE public.value_metrics_id_seq
    AS integer
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1;


ALTER TABLE public.value_metrics_id_seq OWNER TO ai_user;

--
-- Name: value_metrics_id_seq; Type: SEQUENCE OWNED BY; Schema: public; Owner: ai_user
--

ALTER SEQUENCE public.value_metrics_id_seq OWNED BY public.value_metrics.id;


--
-- Name: workflow_connections; Type: TABLE; Schema: public; Owner: ai_user
--

CREATE TABLE public.workflow_connections (
    id uuid NOT NULL,
    workflow_id uuid NOT NULL,
    source_node_id uuid NOT NULL,
    target_node_id uuid NOT NULL,
    condition character varying(500),
    created_at timestamp without time zone DEFAULT now() NOT NULL,
    updated_at timestamp without time zone DEFAULT now() NOT NULL,
    label character varying(200),
    style jsonb DEFAULT '{}'::jsonb
);


ALTER TABLE public.workflow_connections OWNER TO ai_user;

--
-- Name: workflow_definitions; Type: TABLE; Schema: public; Owner: ai_user
--

CREATE TABLE public.workflow_definitions (
    id uuid NOT NULL,
    name character varying(200) NOT NULL,
    description text,
    version character varying(50) DEFAULT '1.0.0'::character varying NOT NULL,
    status public.workflowstatus DEFAULT 'draft'::public.workflowstatus NOT NULL,
    config jsonb NOT NULL,
    created_by uuid,
    created_at timestamp without time zone DEFAULT now() NOT NULL,
    updated_at timestamp without time zone DEFAULT now() NOT NULL,
    workflow_metadata jsonb DEFAULT '{}'::jsonb
);


ALTER TABLE public.workflow_definitions OWNER TO ai_user;

--
-- Name: workflow_executions; Type: TABLE; Schema: public; Owner: ai_user
--

CREATE TABLE public.workflow_executions (
    id uuid NOT NULL,
    workflow_id uuid NOT NULL,
    executed_by uuid,
    status public.executionstatus DEFAULT 'pending'::public.executionstatus NOT NULL,
    input_data jsonb,
    output_data jsonb,
    error_message text,
    started_at timestamp without time zone,
    finished_at timestamp without time zone,
    duration_seconds double precision,
    execution_log jsonb,
    created_at timestamp without time zone DEFAULT now() NOT NULL,
    updated_at timestamp without time zone DEFAULT now() NOT NULL,
    progress double precision DEFAULT 0.0 NOT NULL,
    current_node_id character varying(100),
    node_results jsonb,
    start_time timestamp without time zone,
    end_time timestamp without time zone,
    execution_time double precision,
    execution_metadata jsonb DEFAULT '{}'::jsonb
);


ALTER TABLE public.workflow_executions OWNER TO ai_user;

--
-- Name: COLUMN workflow_executions.progress; Type: COMMENT; Schema: public; Owner: ai_user
--

COMMENT ON COLUMN public.workflow_executions.progress IS '执行进度（0-1）';


--
-- Name: COLUMN workflow_executions.current_node_id; Type: COMMENT; Schema: public; Owner: ai_user
--

COMMENT ON COLUMN public.workflow_executions.current_node_id IS '当前节点ID';


--
-- Name: COLUMN workflow_executions.node_results; Type: COMMENT; Schema: public; Owner: ai_user
--

COMMENT ON COLUMN public.workflow_executions.node_results IS '节点执行结果';


--
-- Name: COLUMN workflow_executions.start_time; Type: COMMENT; Schema: public; Owner: ai_user
--

COMMENT ON COLUMN public.workflow_executions.start_time IS '开始时间';


--
-- Name: COLUMN workflow_executions.end_time; Type: COMMENT; Schema: public; Owner: ai_user
--

COMMENT ON COLUMN public.workflow_executions.end_time IS '结束时间';


--
-- Name: COLUMN workflow_executions.execution_time; Type: COMMENT; Schema: public; Owner: ai_user
--

COMMENT ON COLUMN public.workflow_executions.execution_time IS '执行耗时（秒）';


--
-- Name: COLUMN workflow_executions.execution_metadata; Type: COMMENT; Schema: public; Owner: ai_user
--

COMMENT ON COLUMN public.workflow_executions.execution_metadata IS '执行元数据';


--
-- Name: workflow_nodes; Type: TABLE; Schema: public; Owner: ai_user
--

CREATE TABLE public.workflow_nodes (
    id uuid NOT NULL,
    workflow_id uuid NOT NULL,
    node_id character varying(100) NOT NULL,
    node_type public.nodetype NOT NULL,
    name character varying(200) NOT NULL,
    config jsonb NOT NULL,
    position_x double precision,
    position_y double precision,
    created_at timestamp without time zone DEFAULT now() NOT NULL,
    updated_at timestamp without time zone DEFAULT now() NOT NULL,
    description text,
    style jsonb DEFAULT '{}'::jsonb,
    "position" jsonb
);


ALTER TABLE public.workflow_nodes OWNER TO ai_user;


--

CREATE TABLE public.ai_models (
    id integer NOT NULL,
    name character varying(255) NOT NULL,
    display_name character varying(255),
    description text,
    model_type public.modeltype NOT NULL,
    status public.modelstatus DEFAULT 'active'::public.modelstatus NOT NULL,
    model_version character varying(50),
    framework character varying(100),
    model_path character varying(500),
    model_size integer,
    training_dataset character varying(255),
    training_config jsonb,
    hyperparameters jsonb,
    training_metrics jsonb,
    accuracy double precision,
    "precision" double precision,
    recall double precision,
    f1_score double precision,
    performance_metrics jsonb,
    deployment_endpoint character varying(500),
    deployment_config jsonb,
    inference_latency double precision,
    business_owner character varying(100),
    technical_owner character varying(100),
    tags jsonb,
    use_cases jsonb,
    metadata jsonb,
    created_at timestamp without time zone DEFAULT now() NOT NULL,
    updated_at timestamp without time zone DEFAULT now() NOT NULL
);


ALTER TABLE public.ai_models OWNER TO ai_user;


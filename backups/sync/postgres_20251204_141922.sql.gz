f5f8f4f9-dedb-4157-a46b-0e2f953db09f	send_email	发送电子邮件。支持文本和HTML格式，可以添加附件、抄送和密送。需要配置SMTP服务器信息。	\N	CUSTOM	{"type": "object", "required": ["to_emails", "subject", "body"], "properties": {"body": {"type": "string", "minLength": 1, "description": "邮件正文内容（必需）"}, "subject": {"type": "string", "maxLength": 200, "minLength": 1, "description": "邮件主题（必需）"}, "reply_to": {"type": "string", "format": "email", "description": "回复邮箱地址（可选）"}, "body_type": {"enum": ["text", "html"], "type": "string", "default": "text", "description": "正文类型：text（纯文本）或html（HTML格式）"}, "cc_emails": {"type": ["string", "array"], "items": {"type": "string", "format": "email"}, "description": "抄送邮箱地址（可选）。可以是字符串（多个邮箱用逗号或分号分隔）或数组"}, "to_emails": {"type": ["string", "array"], "items": {"type": "string", "format": "email"}, "examples": ["user@example.com", "user1@example.com,user2@example.com", ["user1@example.com", "user2@example.com"]], "description": "收件人邮箱地址（必需）。可以是字符串（多个邮箱用逗号或分号分隔）或数组"}, "bcc_emails": {"type": ["string", "array"], "items": {"type": "string", "format": "email"}, "description": "密送邮箱地址（可选）。可以是字符串（多个邮箱用逗号或分号分隔）或数组"}, "from_email": {"type": "string", "format": "email", "description": "发件人邮箱地址（可选，默认使用配置的发件人）"}, "attachments": {"type": "array", "items": {"type": "object", "required": ["filename", "content"], "properties": {"content": {"type": ["string", "object"], "description": "附件内容（字符串或base64编码）"}, "filename": {"type": "string", "description": "附件文件名"}, "content_type": {"type": "string", "default": "application/octet-stream", "description": "附件内容类型（如：text/plain, application/pdf等）"}}}, "description": "附件列表（可选）。每个附件包含filename（文件名）、content（内容，base64编码或字节）和content_type（内容类型）"}}}	\N	t	\N	2025-11-25 07:28:51.530438	2025-11-27 03:13:31.933008	1.0.0	["to_emails", "subject", "body"]	object	{}	{}	26	8	18	2.9790223478018296	ACTIVE
5d93f687-4851-4653-a43e-569a021d4b66	sap_erp_table_query	查询SAP ERP（S4 HANA）表数据。通过RFC直接连接SAP系统并执行表查询。支持字段选择、WHERE条件和分页。	\N	CUSTOM	{"type": "object", "required": ["table_name"], "properties": {"fields": {"type": "array", "items": {"type": "string"}, "examples": [["BELNR", "GJAHR", "BUKRS"], ["VBELN", "ERDAT", "VKORG"]], "description": "要查询的字段列表（可选）。如果不指定，查询所有字段"}, "max_rows": {"type": "integer", "default": 100, "maximum": 10000, "minimum": 1, "description": "最大返回行数（默认100，最大10000）"}, "order_by": {"type": "string", "examples": ["BELNR", "GJAHR DESC", "ERDAT ASC"], "description": "排序字段（可选），例如：BELNR DESC"}, "table_name": {"type": "string", "examples": ["BKPF", "VBAK", "MARA", "KNA1"], "maxLength": 30, "minLength": 1, "description": "SAP表名（必需），如：BKPF（会计凭证表）、VBAK（销售订单表）"}, "where_clause": {"type": "string", "examples": ["BUKRS = '1000'", "GJAHR = '2024' AND MONAT = '01'", "BELNR LIKE '1%'"], "description": "WHERE条件（可选），使用ABAP语法。例如：BUKRS = '1000' AND GJAHR = '2024'"}}}	\N	t	\N	2025-11-27 04:36:03.454952	2025-11-27 04:36:03.454952	1.0.0	["table_name"]	object	{}	{}	0	0	0	\N	ACTIVE

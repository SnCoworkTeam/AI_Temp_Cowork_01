62d6dda9-c82b-4f7c-9a68-b4c30fc2149c	knowledge_graph	查询和扩展企业知识图谱，获取概念之间的关系和相关信息。	\N	CUSTOM	{"type": "object", "required": ["operation"], "properties": {"depth": {"type": "integer", "default": 2, "maximum": 5, "minimum": 1, "description": "扩展深度（expand时可选）"}, "limit": {"type": "integer", "default": 10, "maximum": 50, "minimum": 1, "description": "结果数量限制（get_related时可选）"}, "concept": {"type": "string", "required": false, "description": "概念名称（get_related时必需）"}, "operation": {"enum": ["get_related", "expand"], "type": "string", "required": true, "description": "操作类型"}, "seed_concepts": {"type": "array", "items": {"type": "string"}, "required": false, "description": "种子概念列表（expand时必需，可以是数组或逗号分隔的字符串）"}}}	\N	t	\N	2025-11-25 07:30:04.088612	2025-11-25 07:30:04.088612	1.0.0	["operation"]	object	{}	{}	0	0	0	\N	ACTIVE

ARG PYTHON_VERSION=3.11
FROM python:${PYTHON_VERSION}-slim-bookworm

# 设置工作目录
WORKDIR /app

# 配置 Debian 镜像源（使用清华镜像，保持原有 Debian 版本）
RUN sed -i 's|http://deb.debian.org|https://mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's|http://deb.debian.org|https://mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list 2>/dev/null || true

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 配置pip使用国内镜像源（清华镜像）
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip config set global.timeout 300 && \
    pip config set global.retries 5

# 复制requirements并安装依赖
COPY chat-service/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# 安装shared_libs包
COPY shared_libs /tmp/shared_libs
RUN pip install -e /tmp/shared_libs

# 复制database
COPY database /database

# 复制应用代码
COPY chat-service /app

# 暴露端口
EXPOSE 8006

# 设置环境变量
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app:/database

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8006/health || exit 1

# 启动命令（开发模式，带热重载）
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8006", "--reload"]

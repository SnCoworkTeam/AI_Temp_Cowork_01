FROM python:3.11-slim-bookworm

WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    unixodbc-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 安装Python依赖
RUN pip install --no-cache-dir \
    fastapi==0.104.1 \
    uvicorn[standard]==0.24.0 \
    pydantic==2.5.0 \
    pydantic-settings==2.1.0 \
    httpx==0.25.2 \
    sqlalchemy==2.0.23 \
    python-dotenv==1.0.0 \
    aiofiles==23.2.1 \
    tenacity==8.2.3

# 设置环境变量
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# 暴露端口
EXPOSE 8015

# 开发模式：使用热重载
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8015", "--reload"]



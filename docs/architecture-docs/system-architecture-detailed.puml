@startuml LuminaOS系统详细架构图
!theme plain
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle
skinparam linetype ortho

title LuminaOS 企业AI平台 - 详细系统架构图

' 定义颜色
skinparam component {
    BackgroundColor<<Infrastructure>> #E8F4F8
    BackgroundColor<<Core>> #FFF4E6
    BackgroundColor<<Business>> #E8F5E9
    BackgroundColor<<Frontend>> #F3E5F5
    BackgroundColor<<External>> #FFEBEE
    BorderColor #2E7D32
    ArrowColor #1976D2
}

' ============================================
' 外部系统
' ============================================
package "外部系统" <<External>> {
    component [SAP ERP] as SAPERP
    component [Dify] as Dify
    actor "用户" as Users
}

' ============================================
' 前端层
' ============================================
package "前端层" <<Frontend>> {
    component [Web UI\nNext.js 14\nPort: 3000] as WebUI
}

' ============================================
' API网关层
' ============================================
package "API网关层" <<Core>> {
    component [API Gateway\nPort: 8080] as APIGateway
}

' ============================================
' 核心架构服务
' ============================================
package "核心架构服务" <<Core>> {
    component [Registry Service\nPort: 8000] as Registry
    component [Config Center\nPort: 8090] as ConfigCenter
}

' ============================================
' AI核心服务层
' ============================================
package "AI核心服务层" <<Business>> {
    component [Agent Service\nPort: 8010] as AgentService
    component [Agent Orchestrator\nPort: 8011] as AgentOrchestrator
    component [Agent Registry\nPort: 8012] as AgentRegistry
    component [Workflow Engine\nPort: 8002] as WorkflowEngine
    component [DAG Orchestrator\nPort: 8009] as DAGOrchestrator
}

' ============================================
' 数据与知识服务层
' ============================================
package "数据与知识服务层" <<Business>> {
    component [Knowledge Base\nPort: 8004] as KnowledgeBase
    component [Metadata Service\nPort: 8005] as MetadataService
    component [Memory Service\nPort: 8013] as MemoryService
    component [Vector Coordinator\nPort: 8020] as VectorCoordinator
}

' ============================================
' 集成与工具服务层
' ============================================
package "集成与工具服务层" <<Business>> {
    component [MCP Gateway\nPort: 8001] as MCPGateway
    component [SAP MCP Server\nPort: 3001] as SAPMCPServer
    component [SAP Metadata Agent\nPort: 8015] as SAPMetadataAgent
    component [JoyAgent Adapter\nPort: 8007] as JoyAgentAdapter
}

' ============================================
' 基础服务层
' ============================================
package "基础服务层" <<Business>> {
    component [Auth Service\nPort: 8003] as AuthService
    component [Chat Service\nPort: 8006] as ChatService
}

' ============================================
' 基础设施层
' ============================================
package "基础设施层" <<Infrastructure>> {
    database "PostgreSQL\nPort: 5432" as PostgreSQL
    database "Redis\nPort: 6379" as Redis
    database "Qdrant\nPort: 6333" as Qdrant
    database "Neo4j\nPort: 7474" as Neo4j
}

' ============================================
' 用户交互流
' ============================================
Users --> WebUI
WebUI --> APIGateway

' ============================================
' API网关路由
' ============================================
APIGateway --> Registry
APIGateway --> ConfigCenter
APIGateway --> AgentService
APIGateway --> WorkflowEngine
APIGateway --> KnowledgeBase
APIGateway --> MetadataService
APIGateway --> AuthService
APIGateway --> ChatService
APIGateway --> MCPGateway

' ============================================
' AI核心服务交互
' ============================================
AgentService --> AgentRegistry
AgentService --> AgentOrchestrator
AgentService --> WorkflowEngine
AgentService --> KnowledgeBase
AgentService --> MetadataService
AgentService --> MCPGateway
AgentService --> MemoryService

AgentOrchestrator --> AgentService
AgentOrchestrator --> WorkflowEngine
AgentOrchestrator --> DAGOrchestrator

WorkflowEngine --> MCPGateway
WorkflowEngine --> KnowledgeBase

DAGOrchestrator --> AgentService
DAGOrchestrator --> WorkflowEngine
DAGOrchestrator --> MCPGateway

' ============================================
' 数据与知识服务交互
' ============================================
KnowledgeBase --> MetadataService
KnowledgeBase --> VectorCoordinator

MetadataService --> SAPMetadataAgent

' ============================================
' 集成服务交互
' ============================================
MCPGateway --> SAPMCPServer
MCPGateway --> JoyAgentAdapter

SAPMCPServer --> SAPERP
SAPMetadataAgent --> SAPERP

ChatService --> AgentService
ChatService --> KnowledgeBase

' ============================================
' 数据库连接
' ============================================
AgentService --> PostgreSQL
AgentService --> Redis
AgentService --> Qdrant

WorkflowEngine --> PostgreSQL
WorkflowEngine --> Redis

KnowledgeBase --> PostgreSQL
KnowledgeBase --> Qdrant
KnowledgeBase --> Neo4j

MetadataService --> PostgreSQL
MetadataService --> Neo4j

MemoryService --> Qdrant
MemoryService --> PostgreSQL

AuthService --> PostgreSQL

ChatService --> PostgreSQL
ChatService --> Redis

VectorCoordinator --> Qdrant

' ============================================
' 配置与注册
' ============================================
AgentService ..> Registry
AgentService ..> ConfigCenter
WorkflowEngine ..> Registry
WorkflowEngine ..> ConfigCenter
KnowledgeBase ..> Registry
MetadataService ..> Registry

' ============================================
' 注释说明
' ============================================
note right of APIGateway
统一入口
- 智能路由
- 认证授权
- 限流熔断
- 流式支持
end note

note right of AgentService
智能体核心
- 意图识别
- 任务分类
- 服务集成
- 流式执行
end note

note right of WorkflowEngine
工作流引擎
- BPMN 2.0支持
- AI节点扩展
- LangGraph执行
- 状态持久化
end note

note right of KnowledgeBase
知识库服务
- 文档处理
- 向量索引
- 语义搜索
- 知识图谱
end note

@enduml




